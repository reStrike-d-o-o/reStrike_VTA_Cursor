# Ignore configuration files to prevent rebuild loops
config/
**/config/**
*.json
!package.json
!package-lock.json
!tsconfig.json
!tailwind.config.js
!postcss.config.js
!eslint.config.js 

# Ignore log files to prevent rebuild loops when logging changes
log/
**/log/**
logs/
**/logs/**
*.log
*.log.*

# Ignore SQLite database files generated during development
restrike_vta.db
restrike_vta.db-shm
restrike_vta.db-wal
**/restrike_vta.db
**/restrike_vta.db-shm
**/restrike_vta.db-wal

# Ignore temporary files
*.tmp
*.temp
*.bak
*.backup

# Ignore build artifacts
target/
dist/
build/
node_modules/ 
